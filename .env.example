# Copy to .env.local and fill in. .env.local is ignored by git.

# Safe for the browser. Access is limited by row-level security.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Scripts only. Never prefix these with VITE_, or they get bundled into the website.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
