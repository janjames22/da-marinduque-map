# Copy to .env.local and fill in. .env.local is ignored by git. Never paste these values into a chat.

# Project Settings > API. Safe for the browser: access is limited by row-level security.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use one of these. New projects have the publishable key; the anon key is the older name.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Scripts only. Never prefix these with VITE_, or they get built into the website.
# Use one of these two. The secret key is the newer name for the service_role key.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The Connect button > Session pooler, which works on any network. The direct address needs IPv6.
# Put in the database password. If it has special characters such as @ or #, percent-encode them.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# The deployed site's address, once there is one. Invite links send people here.
APP_URL=
