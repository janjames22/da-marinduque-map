{
  "name": "da-marinduque-intervention-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode localdata",
    "dev:phone": "vite --mode phone --host",
    "build": "tsc -b && vite build && tsx scripts/check-bundle.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "seed:dry-run": "tsx scripts/seed-interventions.ts",
    "build:field-sheet": "tsx scripts/build-field-verification.ts",
    "build:local-seed": "tsx scripts/build-local-seed.ts",
    "test:e2e": "playwright test",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "check:supabase": "tsx scripts/check-supabase.ts",
    "users": "tsx scripts/users.ts",
    "export:samples": "tsx scripts/export-samples.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "deploy": "npm run build && npx netlify-cli deploy --prod --dir=dist",
    "deploy:functions": "tsx scripts/deploy-functions.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-table": "^8.21.3",
    "@tmcw/togeojson": "^7.1.3",
    "exifr": "^7.1.3",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-postgis": "^0.2.15",
    "@napi-rs/canvas": "^1.1.0",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/shapefile": "^0.6.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@xmldom/xmldom": "^0.9.12",
    "mapshaper": "^0.7.101",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "shapefile": "^0.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
