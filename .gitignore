node_modules/
dist/
*.local
.env
.env.*
!.env.example

# Test output
coverage/
playwright-report/
test-results/

*.tsbuildinfo

# Original source report (5 MB). Keep it locally; the seed CSV is what the app uses.
data/source/*.pdf

# Generated by npm run build:local-seed
data/local/

# npm run backup. These hold beneficiary names.
backups/

# Exported files and npm run export:samples. These hold beneficiary names too.
exports/

# The demo site: its made-up data (npm run build:demo-seed) and its build (npm run build:demo)
data/demo/
dist-demo/

# Production build used by the browser tests
.e2e-dist/
.e2e-dist-live/
.e2e-dist-demo/

# Which Netlify site this folder deploys to
.netlify/

# The Supabase command line's working files
supabase/.temp/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
